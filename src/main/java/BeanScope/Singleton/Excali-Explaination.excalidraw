      "link": null,
      "locked": false,
      "text": "package BeanScope.Singleton;\n\nimport org.springframework.context.ApplicationContext;\nimport org.springframework.context.annotation.AnnotationConfigApplicationContext;\nimport org.springframework.context.support.ApplicationObjectSupport;\n\npublic class Main {\n    public static void main(String[] args) {\n        ApplicationContext context = new AnnotationConfigApplicationContext(AppConfig.class);\n\n        User1 u1 = context.getBean(User1.class);\n        User2 u2 = context.getBean(User2.class);\n\n        u1.getBalance();\n        u2.getBalance();\n\n        u1.withDraw(500);\n\n        u1.getBalance();\n        u2.getBalance();\n\n    }\n}\n",
      "fontSize": 19.789881262388892,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "package BeanScope.Singleton;\n\nimport org.springframework.context.ApplicationContext;\nimport org.springframework.context.annotation.AnnotationConfigApplicationContext;\nimport org.springframework.context.support.ApplicationObjectSupport;\n\npublic class Main {\n    public static void main(String[] args) {\n        ApplicationContext context = new AnnotationConfigApplicationContext(AppConfig.class);\n\n        User1 u1 = context.getBean(User1.class);\n        User2 u2 = context.getBean(User2.class);\n\n        u1.getBalance();\n        u2.getBalance();\n\n        u1.withDraw(500);\n\n        u1.getBalance();\n        u2.getBalance();\n\n    }\n}\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
